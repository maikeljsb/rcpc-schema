{
  "$defs": {
    "CapabilityType": {
      "additionalProperties": false,
      "description": "Something a robot can do, named by a verb. Required by primitive tasks and offered by robots.",
      "properties": {
        "description": {
          "description": "What this is, in one or two plain sentences.",
          "type": "string"
        },
        "id": {
          "description": "Identifier, unique among instances of its class.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "description"
      ],
      "title": "CapabilityType",
      "type": "object"
    },
    "ParameterKind": {
      "description": "The kinds of value a task parameter can hold.",
      "enum": [
        "position",
        "component_reference",
        "quantity"
      ],
      "title": "ParameterKind",
      "type": "string"
    },
    "Position": {
      "additionalProperties": false,
      "description": "A cartesian point and the unit its coordinates are in. On site, in the IFC project coordinate frame.",
      "properties": {
        "unit": {
          "description": "The unit of the value, or of the coordinates.",
          "type": "string"
        },
        "x_coord": {
          "description": "Cartesian x coordinate.",
          "type": "number"
        },
        "y_coord": {
          "description": "Cartesian y coordinate.",
          "type": "number"
        },
        "z_coord": {
          "description": "Cartesian z coordinate.",
          "type": "number"
        }
      },
      "required": [
        "x_coord",
        "y_coord",
        "z_coord",
        "unit"
      ],
      "title": "Position",
      "type": "object"
    },
    "Quantity": {
      "additionalProperties": false,
      "description": "A number with a unit.",
      "properties": {
        "unit": {
          "description": "The unit of the value, or of the coordinates.",
          "type": "string"
        },
        "value": {
          "description": "The numeric value.",
          "type": "number"
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "title": "Quantity",
      "type": "object"
    }
  },
  "$id": "https://rcpc.for5672/schema/common",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "metamodel_version": "1.11.0",
  "title": "common",
  "type": "object",
  "version": "0.1.0"
}
